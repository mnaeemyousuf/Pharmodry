# Pharmodry — environment for docker-compose (infrastructure/docker-compose.yml).
# Copy to .env at the repository root. Per-app variables are documented in
# apps/api/.env.example and apps/web/.env.example.

POSTGRES_USER=pharmodry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pharmodry

# REQUIRED: at least 32 random characters.
JWT_ACCESS_SECRET=

# Optional — leave empty to run without AI.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Demo mode shows demo accounts on the login page; seed only into non-production databases.
NEXT_PUBLIC_DEMO_MODE=false
SEED_DEMO_PASSWORD=
