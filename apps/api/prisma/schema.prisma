  @@index([tenantId, createdAt])
  @@map("deviations")
}

/// Structured RCA (5-Whys + fishbone) for a deviation or OOS. AI suggestions never land here automatically.
model RootCauseAnalysis {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  deviationId  String?   @db.Uuid
  oosId        String?   @db.Uuid
  fiveWhys     Json      @default("[]")
  /// {HUMAN:[],MACHINE:[],METHOD:[],MATERIAL:[],MEASUREMENT:[],ENVIRONMENT:[]}
  fishbone     Json      @default("{}")
  primaryCategory String?
  statement    String
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  @@index([tenantId, deviationId])
  @@index([tenantId, oosId])
  @@map("root_cause_analyses")
}

model Capa {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @db.Uuid
  siteId                String       @db.Uuid
  number                String
  source                CapaSource
  deviationId           String?      @db.Uuid
  oosId                 String?      @db.Uuid
  problemStatement      String
  rootCause             String?
  priority              Priority
  ownerId               String       @db.Uuid
  departmentId          String?      @db.Uuid
  dueDate               DateTime
  status                CapaStatus   @default(OPEN)
  effectivenessCriteria String?
  effectivenessResult   String?
  effectivenessEffective Boolean?
  effectivenessCheckedAt DateTime?
  effectivenessCheckedById String?   @db.Uuid
  effectivenessFailures Int          @default(0)
  closedAt              DateTime?
  closedById            String?      @db.Uuid
  createdById           String       @db.Uuid
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  actions CapaAction[]

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@map("capas")
}

model CapaAction {
  id          String           @id @default(uuid()) @db.Uuid
