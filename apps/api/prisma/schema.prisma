model Batch {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  siteId              String      @db.Uuid
  batchNumber         String
  productId           String      @db.Uuid
  planLineId          String?     @db.Uuid
  bomId               String      @db.Uuid
  routingId           String      @db.Uuid
  productionLineId    String?     @db.Uuid
  plannedQuantity     Decimal     @db.Decimal(18, 4)
  theoreticalYield    Decimal     @db.Decimal(18, 4)
  actualYield         Decimal?    @db.Decimal(18, 4)
  yieldPct            Decimal?    @db.Decimal(7, 2)
  yieldWithinLimits   Boolean?
  yieldJustification  String?
  yieldDeviationId    String?     @db.Uuid
  uomCode             String
  status              BatchStatus @default(PLANNED)
  plannedStart        DateTime
  plannedEnd          DateTime?
  actualStart         DateTime?
  actualEnd           DateTime?
  mfgDate             DateTime?
  expiryDate          DateTime?
  createdById         String      @db.Uuid
  qaDecisionById      String?     @db.Uuid
  qaDecisionAt        DateTime?
  qaDecisionComment   String?
  version             Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  product      Product                    @relation(fields: [productId], references: [id])
  steps        BatchStep[]
  consumptions BatchMaterialConsumption[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, status])
  @@index([tenantId, productId, createdAt])
  @@map("batches")
}

model BatchStep {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @db.Uuid
  batchId              String          @db.Uuid
  routingStepId        String          @db.Uuid
  sequence             Int
  code                 String
  name                 String
  instructions         String
  equipmentType        String?
  expectedDurationMin  Int?
  requiresVerification Boolean
  consumesMaterials    Boolean
  recordsOutput        Boolean
  parameterDefs        Json
  ipcDefs              Json
  status               BatchStepStatus @default(PENDING)
  equipmentId          String?         @db.Uuid
  calibrationOverrideReason String?
  readings             Json            @default("{}")
  ipcResults           Json            @default("{}")
  outputQuantity       Decimal?        @db.Decimal(18, 4)
  remarks              String?
  startedAt            DateTime?
  startedById          String?         @db.Uuid
  completedAt          DateTime?
  completedById        String?         @db.Uuid
  completionSignatureId String?        @db.Uuid
  verifiedAt           DateTime?
  verifiedById         String?         @db.Uuid
  verificationSignatureId String?      @db.Uuid
  hasOutOfLimitReading Boolean         @default(false)

  batch       Batch                 @relation(fields: [batchId], references: [id])
  corrections BatchStepCorrection[]

  @@unique([batchId, sequence])
  @@map("batch_steps")
}

model BatchStepCorrection {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  batchStepId   String   @db.Uuid
  field         String
  originalValue Json?
  newValue      Json?
  reason        String
  correctedById String   @db.Uuid
  correctedAt   DateTime @default(now())

  step BatchStep @relation(fields: [batchStepId], references: [id])

  @@map("batch_step_corrections")
}

model BatchMaterialConsumption {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  batchId          String   @db.Uuid
  batchStepId      String?  @db.Uuid
  materialId       String   @db.Uuid
  lotId            String   @db.Uuid
  expectedQuantity Decimal  @db.Decimal(18, 4)
  actualQuantity   Decimal  @db.Decimal(18, 4)
  variancePct      Decimal  @db.Decimal(9, 2)
  uomCode          String
  recordedById     String   @db.Uuid
  recordedAt       DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([tenantId, batchId])
  @@map("batch_material_consumptions")
}

// ───────────────────────────── Quality Control ─────────────────────────────

model QcSample {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  siteId          String          @db.Uuid
  number          String
  stage           QcStage
  specificationId String          @db.Uuid
  materialId      String?         @db.Uuid
  productId       String?         @db.Uuid
  lotId           String?         @db.Uuid
  batchId         String?         @db.Uuid
  status          QcSampleStatus  @default(REQUESTED)
  conclusion      QcConclusion?
  requestedAt     DateTime        @default(now())
  requestedById   String?         @db.Uuid
  collectedAt     DateTime?
  collectedById   String?         @db.Uuid
  sampleQuantity  Decimal?        @db.Decimal(18, 4)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?         @db.Uuid
  approvedAt      DateTime?
  approvedById    String?         @db.Uuid
  remarks         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  results QcResult[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, batchId])
  @@index([tenantId, lotId])
  @@map("qc_samples")
}

model QcResult {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  sampleId        String           @db.Uuid
  specTestId      String           @db.Uuid
  testName        String
  resultType      SpecResultType
  /// specification snapshot at time of entry {operator,minValue,maxValue,expectedText,unit}
  specSnapshot    Json
  numericValue    Decimal?         @db.Decimal(18, 4)
  textValue       String?
  passFail        Boolean?
  unit            String?
  evaluation      ResultEvaluation
  status          QcResultStatus   @default(ENTERED)
  isRetest        Boolean          @default(false)
  instrument      String?
  analystId       String           @db.Uuid
  enteredAt       DateTime         @default(now())
  invalidatedReason String?
  invalidatedById String?          @db.Uuid
  invalidatedAt   DateTime?

  sample QcSample @relation(fields: [sampleId], references: [id])

  @@index([tenantId, sampleId])
  @@map("qc_results")
}

model OosInvestigation {
  id                          String         @id @default(uuid()) @db.Uuid
  tenantId                    String         @db.Uuid
  siteId                      String         @db.Uuid
  number                      String
  qcResultId                  String         @db.Uuid
  sampleId                    String         @db.Uuid
