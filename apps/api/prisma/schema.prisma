// Pharmodry — PostgreSQL schema (Prisma)
// Conventions:
//  * UUID primary keys; human-readable numbers are separate unique columns per tenant.
//  * Every business table carries tenantId; tenant isolation is additionally enforced in the ORM layer.
//  * User references on regulated records (createdById, approvedById, …) are plain UUID columns.
//    Users are never deleted (only deactivated) so references remain resolvable.
//  * Regulated records are never physically deleted: CANCELLED / INACTIVE / voided statuses instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum MasterStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MaterialType {
  API
  EXCIPIENT
  PACKAGING
  CONSUMABLE
}

enum SupplierStatus {
  PENDING_QUALIFICATION
  APPROVED
  CONDITIONALLY_APPROVED
  SUSPENDED
  BLACKLISTED
}

enum WarehouseType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOODS
  QUARANTINE
  REJECT
  GENERAL
}

enum EquipmentQualificationStatus {
  QUALIFIED
  PENDING
  NOT_QUALIFIED
  RETIRED
}

enum ItemType {
  MATERIAL
  PRODUCT
}

enum InventoryStatus {
  QUARANTINE
  UNDER_TEST
  RELEASED
  REJECTED
  BLOCKED
  EXPIRED
  RETURNED
  RECALLED
}

enum InventoryTxnType {
  GRN_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  ISSUE_TO_PRODUCTION
  RETURN_FROM_PRODUCTION
  ADJUSTMENT
  STATUS_CHANGE
  RESERVE
  UNRESERVE
  QC_SAMPLING
  FG_RECEIPT
  DISPATCH
}

enum ReservationStatus {
  ACTIVE
  ISSUED
  RELEASED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum GrnStatus {
  RECEIVED
  COMPLETED
  CANCELLED
}

enum ProductionPlanStatus {
  DRAFT
  APPROVED
  CLOSED
}

enum BatchStatus {
  PLANNED
  MATERIAL_RESERVED
  READY
  IN_PROGRESS
  AWAITING_QC
  AWAITING_QA
  RELEASED
  REJECTED
  CLOSED
  CANCELLED
}

enum BatchStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum QcStage {
  RAW_MATERIAL
  PACKAGING_MATERIAL
  IN_PROCESS
  FINISHED_PRODUCT
}

enum QcSampleStatus {
  REQUESTED
  COLLECTED
  IN_TESTING
  SUBMITTED
  REVIEWED
  APPROVED
  CANCELLED
}

enum QcConclusion {
  PASS
  FAIL
}

enum SpecResultType {
  NUMERIC
  TEXT
  PASS_FAIL
}

enum SpecOperator {
  RANGE
  MIN
  MAX
  EQUALS
  INFO
}

enum QcResultStatus {
  ENTERED
  INVALIDATED
}

enum ResultEvaluation {
  WITHIN_SPEC
  OOS_CANDIDATE
  NOT_EVALUATED
}

enum OosStatus {
  REPORTED
  PRELIMINARY_INVESTIGATION
  LAB_INVESTIGATION
  MANUFACTURING_INVESTIGATION
  ROOT_CAUSE
  IMPACT_ASSESSMENT
  CAPA
  QA_APPROVAL
  CLOSED
}

enum OosConclusion {
  CONFIRMED_OOS
  INVALIDATED_LAB_ERROR
}

enum DeviationStatus {
  DRAFT
  SUBMITTED
  QA_REVIEW
  INVESTIGATION
  ROOT_CAUSE
  CAPA
  EFFECTIVENESS_CHECK
  CLOSED
  CANCELLED
}

enum Severity {
  MINOR
  MAJOR
  CRITICAL
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  EFFECTIVENESS_CHECK
  CLOSED
  CANCELLED
}

enum CapaSource {
  DEVIATION
  OOS
  OOT
  AUDIT
  COMPLAINT
  SUPPLIER
  RECALL
  OTHER
}

enum CapaActionType {
  CORRECTIVE
  PREVENTIVE
}

enum CapaActionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AiRole {
  USER
  ASSISTANT
}

enum AiRating {
  UP
  DOWN
}

enum IntegrationStatus {
  PENDING
  SUCCESS
  FAILED
}

// ───────────────────────── Organisation & identity ─────────────────────────

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  legalName String?
  country   String       @default("PK")
  regulator String       @default("DRAP")
  timezone  String       @default("Asia/Karachi")
  currency  String       @default("PKR")
  settings  Json         @default("{}")
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sites       Site[]
  departments Department[]
  users       User[]
  roles       Role[]

  @@map("tenants")
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  city      String?
  country   String   @default("PK")
  licenseNo String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  warehouses      Warehouse[]
  departments     Department[]
  productionLines ProductionLine[]

  @@unique([tenantId, code])
  @@map("sites")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  siteId    String?  @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  site   Site?  @relation(fields: [siteId], references: [id])
  users  User[]

  @@unique([tenantId, code])
  @@map("departments")
}

model ProductionLine {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  siteId   String  @db.Uuid
  code     String
  name     String
  area     String?
  isActive Boolean @default(true)

  site Site @relation(fields: [siteId], references: [id])

  @@unique([tenantId, code])
  @@map("production_lines")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  email            String     @unique
  fullName         String
  title            String?
  departmentId     String?    @db.Uuid
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  externalId       String? // reserved for Entra ID / OIDC subject
  passwordChangedAt DateTime  @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  roles      UserRole[]
  sessions   Session[]

  @@index([tenantId, status])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokeReason String?
  replacedById String? @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  module      String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// siteId null ⇒ role applies to all sites of the tenant.
model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  siteId    String?  @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, siteId])
  @@map("user_roles")
}

model NumberSequence {
  tenantId  String   @db.Uuid
  scope     String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([tenantId, scope])
  @@map("number_sequences")
}

// ───────────────────────────── Master data ─────────────────────────────

model UnitOfMeasure {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String

  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model ProductCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String

  products Product[]

  @@unique([tenantId, code])
  @@map("product_categories")
}

model DosageForm {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String

  products Product[]

  @@unique([tenantId, code])
  @@map("dosage_forms")
}

model Product {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  code               String
  genericName        String
  brandName          String?
  dosageFormId       String?      @db.Uuid
  categoryId         String?      @db.Uuid
  strength           String
  packSize           String?
  shelfLifeMonths    Int
  storageConditions  String?
  registrationNumber String?
  /// GS1 GTIN-14 for 2D DataMatrix labelling (DRAP S.R.O. 963(I)/2026)
  gtin               String?
  batchPrefix        String
  uomId              String       @db.Uuid
  standardBatchSize  Decimal      @db.Decimal(18, 4)
  unitPrice          Decimal      @default(0) @db.Decimal(18, 4)
  status             MasterStatus @default(ACTIVE)
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  dosageForm DosageForm?      @relation(fields: [dosageFormId], references: [id])
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  boms       Bom[]
  routings   Routing[]
  batches    Batch[]

  @@unique([tenantId, code])
  @@unique([tenantId, gtin])
  @@map("products")
}

model Material {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  code               String
  name               String
  type               MaterialType
  uomId              String       @db.Uuid
  specificationRef   String?
  storageRequirement String?
  retestPeriodMonths Int?
  safetyStock        Decimal      @default(0) @db.Decimal(18, 4)
  leadTimeDays       Int          @default(30)
  unitCost           Decimal      @default(0) @db.Decimal(18, 4)
  lotPrefix          String       @default("RM")
  status             MasterStatus @default(ACTIVE)
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  suppliers SupplierMaterial[]
  bomLines  BomLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("materials")
}

/// Immutable snapshot history for regulated master data.
model MasterDataVersion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  version     Int
  snapshot    Json
  reason      String?
  changedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, version])
  @@index([tenantId, entityType, entityId])
  @@map("master_data_versions")
}

model Supplier {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @db.Uuid
  code                String
  name                String
  country             String
  contactName         String?
  email               String?
  phone               String?
  address             String?
  status              SupplierStatus @default(PENDING_QUALIFICATION)
  qualificationDate   DateTime?
  requalificationDate DateTime?
  certifications      Json           @default("[]")
  qualityRating       Decimal?       @db.Decimal(5, 2)
  deliveryRating      Decimal?       @db.Decimal(5, 2)
  version             Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  materials SupplierMaterial[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model SupplierMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  supplierId String   @db.Uuid
  materialId String   @db.Uuid
  approved   Boolean  @default(true)
  approvedAt DateTime @default(now())
  manufacturerName String?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([supplierId, materialId])
  @@map("supplier_materials")
}

model Warehouse {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  siteId     String        @db.Uuid
  code       String
  name       String
  type       WarehouseType
  conditions String?
  isActive   Boolean       @default(true)

  site Site          @relation(fields: [siteId], references: [id])
  bins BinLocation[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model BinLocation {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  warehouseId String  @db.Uuid
  code        String
  description String?
  isActive    Boolean @default(true)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
  @@map("bin_locations")
}

model Equipment {
  id                       String                       @id @default(uuid()) @db.Uuid
  tenantId                 String                       @db.Uuid
  siteId                   String                       @db.Uuid
  code                     String
  description              String
  type                     String
  department               String?
  location                 String?
  manufacturer             String?
  model                    String?
  serialNumber             String?
  qualificationStatus      EquipmentQualificationStatus @default(QUALIFIED)
  calibrationFrequencyDays Int?
  lastCalibrationAt        DateTime?
  nextCalibrationDue       DateTime?
  isActive                 Boolean                      @default(true)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  calibrations Calibration[]

  @@unique([tenantId, code])
  @@map("equipment")
}

model Calibration {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  equipmentId   String   @db.Uuid
  performedAt   DateTime
  nextDue       DateTime
  result        String
  certificateNo String?
  performedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@map("calibrations")
}

model Bom {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  productId     String       @db.Uuid
  version       Int
  batchSize     Decimal      @db.Decimal(18, 4)
  status        MasterStatus @default(ACTIVE)
  effectiveFrom DateTime     @default(now())
  createdAt     DateTime     @default(now())

  product Product   @relation(fields: [productId], references: [id])
  lines   BomLine[]

  @@unique([productId, version])
  @@map("boms")
}

model BomLine {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  bomId        String  @db.Uuid
  materialId   String  @db.Uuid
  quantity     Decimal @db.Decimal(18, 4)
  tolerancePct Decimal @default(2) @db.Decimal(6, 2)
  isCritical   Boolean @default(false)
  stepCode     String?

  bom      Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("bom_lines")
}

/// Manufacturing template (master eBMR) for a product.
model Routing {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  productId String       @db.Uuid
  version   Int
  status    MasterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  product Product       @relation(fields: [productId], references: [id])
  steps   RoutingStep[]

  @@unique([productId, version])
  @@map("routings")
}

model RoutingStep {
  id                     String  @id @default(uuid()) @db.Uuid
  tenantId               String  @db.Uuid
  routingId              String  @db.Uuid
  sequence               Int
  code                   String
  name                   String
  instructions           String
  equipmentType          String?
  expectedDurationMin    Int?
  requiresVerification   Boolean @default(true)
  /// [{code,label,unit,min,max,required}]
  parameters             Json    @default("[]")
  /// [{code,label,unit,min,max}]
  ipcChecks              Json    @default("[]")
  /// true for steps where BOM materials are consumed (e.g. dispensing)
  consumesMaterials      Boolean @default(false)
  /// true for the step that records output quantity (e.g. packing)
  recordsOutput          Boolean @default(false)

  routing Routing @relation(fields: [routingId], references: [id], onDelete: Cascade)

  @@unique([routingId, sequence])
  @@map("routing_steps")
}

model TestMethod {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  technique   String?
  reference   String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, code])
  @@map("test_methods")
}

model QcSpecification {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  code       String
  name       String
  stage      QcStage
  materialId String?      @db.Uuid
  productId  String?      @db.Uuid
  version    Int          @default(1)
  status     MasterStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  tests QcSpecTest[]

  @@unique([tenantId, code, version])
  @@index([tenantId, materialId])
  @@index([tenantId, productId])
  @@map("qc_specifications")
}

model QcSpecTest {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  specificationId String         @db.Uuid
  sequence        Int
  name            String
  testMethodId    String?        @db.Uuid
  resultType      SpecResultType
  operator        SpecOperator
  minValue        Decimal?       @db.Decimal(18, 4)
  maxValue        Decimal?       @db.Decimal(18, 4)
  expectedText    String?
  unit            String?
  isMandatory     Boolean        @default(true)

  specification QcSpecification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  @@map("qc_spec_tests")
}

// ───────────────────────────── Procurement ─────────────────────────────

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  siteId       String              @db.Uuid
  number       String
  supplierId   String              @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  currency     String              @default("PKR")
  notes        String?
  createdById  String              @db.Uuid
  approvedById String?             @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @db.Uuid
  purchaseOrderId  String  @db.Uuid
  materialId       String  @db.Uuid
  quantity         Decimal @db.Decimal(18, 4)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  unitPrice        Decimal @default(0) @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  siteId          String    @db.Uuid
  number          String
  supplierId      String    @db.Uuid
  purchaseOrderId String?   @db.Uuid
  status          GrnStatus @default(RECEIVED)
  receivedAt      DateTime  @default(now())
  receivedById    String    @db.Uuid
  deliveryNote    String?
  remarks         String?
  createdAt       DateTime  @default(now())

  lines GoodsReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  goodsReceiptId String   @db.Uuid
  poLineId       String?  @db.Uuid
  materialId     String   @db.Uuid
  supplierBatch  String
  lotId          String   @db.Uuid
  quantity       Decimal  @db.Decimal(18, 4)
  containers     Int      @default(1)
  mfgDate        DateTime
  expiryDate     DateTime
  retestDate     DateTime?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
}

// ───────────────────────────── Inventory ─────────────────────────────

/// One lot at one location. Splitting across bins creates sibling rows sharing lotNumber.
model InventoryLot {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  siteId           String          @db.Uuid
  itemType         ItemType
  materialId       String?         @db.Uuid
  productId        String?         @db.Uuid
  lotNumber        String
  supplierBatch    String?
  supplierId       String?         @db.Uuid
  batchId          String?         @db.Uuid
  mfgDate          DateTime?
  expiryDate       DateTime
  retestDate       DateTime?
  quantity         Decimal         @db.Decimal(18, 4)
  reservedQuantity Decimal         @default(0) @db.Decimal(18, 4)
  uomCode          String
  warehouseId      String          @db.Uuid
  binId            String?         @db.Uuid
  status           InventoryStatus @default(QUARANTINE)
  sourceType       String
  sourceId         String?         @db.Uuid
  unitCost         Decimal         @default(0) @db.Decimal(18, 4)
  version          Int             @default(0)
  dispositionById  String?         @db.Uuid
  dispositionAt    DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  transactions InventoryTransaction[]

  @@index([tenantId, status])
  @@index([tenantId, materialId, status, expiryDate])
  @@index([tenantId, productId])
  @@index([tenantId, lotNumber])
  @@map("inventory_lots")
}

model InventoryTransaction {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  siteId        String           @db.Uuid
  lotId         String           @db.Uuid
  type          InventoryTxnType
  quantity      Decimal          @db.Decimal(18, 4)
  balanceAfter  Decimal          @db.Decimal(18, 4)
  statusFrom    InventoryStatus?
  statusTo      InventoryStatus?
  referenceType String?
  referenceId   String?          @db.Uuid
  reason        String?
