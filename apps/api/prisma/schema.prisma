  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

// ───────────────────────── Compliance infrastructure ─────────────────────────

model ElectronicSignature {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  userId       String   @db.Uuid
  signerName   String
  signerEmail  String
  entityType   String
  entityId     String   @db.Uuid
  action       String
  meaning      String
  reason       String?
  recordHash   String
  authMethod   String   @default("PASSWORD_REAUTH")
  ip           String?
  signedAt     DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("electronic_signatures")
}

/// Append-only. A database trigger rejects UPDATE/DELETE. Rows are hash-chained per tenant.
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  seq           BigInt   @default(autoincrement())
  tenantId      String?  @db.Uuid
  userId        String?  @db.Uuid
  userEmail     String?
  userName      String?
  occurredAt    DateTime @default(now())
  ip            String?
  userAgent     String?
  entityType    String
  entityId      String?
  entityLabel   String?
  action        String
  previousValue Json?
  newValue      Json?
  reason        String?
  correlationId String?
  signatureId   String?  @db.Uuid
  prevHash      String?
  hash          String

  @@unique([seq])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@map("audit_events")
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid
  userId     String               @db.Uuid
  event      String
  severity   NotificationSeverity @default(INFO)
  title      String
  body       String
  entityType String?
  entityId   String?
  link       String?
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())

  @@unique([userId, dedupeKey])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  userId   String  @db.Uuid
  event    String
  inApp    Boolean @default(true)
  email    Boolean @default(false)

  @@unique([userId, event])
  @@map("notification_preferences")
}

// ───────────────────────────── AI governance ─────────────────────────────

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  title     String
  feature   String   @default("COPILOT")
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([tenantId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  conversationId String    @db.Uuid
  role           AiRole
  content        String?
  intent         String?
  contextRefs    Json      @default("[]")
  citations      Json      @default("[]")
  facts          Json?
  provider       String?
  model          String?
  latencyMs      Int?
  promptTokens   Int?
  completionTokens Int?
  redactedAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback     AiFeedback[]

  @@index([tenantId, createdAt])
  @@map("ai_messages")
}

model AiFeedback {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  rating    AiRating
  comment   String?
  createdAt DateTime @default(now())

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("ai_feedback")
}

// ───────────────────────────── Integration ─────────────────────────────

model IntegrationEvent {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  adapter     String
  direction   String
  entityType  String
  source      String
  payloadRef  String?
  status      IntegrationStatus @default(PENDING)
  retryCount  Int               @default(0)
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId, status])
  @@map("integration_events")
}
