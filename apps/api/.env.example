# Pharmodry API — copy to apps/api/.env for local development.
# Never commit real secrets. In production inject these from a secret store (e.g. Azure Key Vault).

NODE_ENV=development
PORT=4100

# PostgreSQL 15+ (UTF-8). Local dev cluster: `npm run db:start` (port 5433).
DATABASE_URL=postgresql://pharma360:pharma360_dev@localhost:5433/pharma360_demo?schema=public

# Access-token signing secret. REQUIRED in production, minimum 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Browser origins allowed to call the API directly (the web app normally proxies same-origin).
CORS_ORIGINS=http://localhost:3000
# Refresh cookie `Secure` flag; defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Rate limits (requests per minute per IP).
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Token refresh happens on every full page load; offices behind one NAT IP share this budget.
REFRESH_RATE_LIMIT_PER_MINUTE=300

# Optional: Redis for BullMQ background jobs. Without it, an in-process timer runs scans (single instance only).
REDIS_URL=
SCANS_INTERVAL_MINUTES=60
DISABLE_SCHEDULER=false

# Optional: Mistral AI (server-side only — never expose to the browser). Without a key the
# copilot and drafting features return computed facts with "AI provider not configured".
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Attachments (local filesystem driver in this release).
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_BYTES=10485760

# Demo seed only. The seed refuses to run when NODE_ENV=production unless ALLOW_DEMO_SEED=true.
SEED_DEMO_PASSWORD=Pharmodry!Demo26
ALLOW_DEMO_SEED=false
