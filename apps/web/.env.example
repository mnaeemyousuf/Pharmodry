# Pharmodry web — copy to apps/web/.env.local for local development.
# The browser never talks to the API host directly: app/api/v1/[...path] proxies same-origin to API_URL.

# Server-side only: where the Next.js proxy forwards /api/v1 requests (read at runtime).
API_URL=http://localhost:4100

# Shows the demo-account picker on the login page. Set to false for any non-demo deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Set to true when building the container image (Next.js standalone output).
BUILD_STANDALONE=false
